# Ambiente
NODE_ENV=development
PORT=3000

# Banco de dados (usado dentro da rede do Docker Compose, host = nome do serviço "db")
DATABASE_URL=postgresql://postgres:postgres@db:5432/busuniversitario
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=busuniversitario
DB_HOST=db
DB_PORT=5432

# Autenticação
JWT_SECRET=troque_este_segredo_por_uma_string_bem_grande_e_aleatoria
JWT_EXPIRES_IN=7d

# CORS (URL do frontend Next.js)
CORS_ORIGIN=http://localhost:3001
